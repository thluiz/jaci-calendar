# calendar-gate — copy to .env and adjust. The .env file goes to chmod 600.

# Loopback only. Never 0.0.0.0: nginx is the only thing that reaches this port.
PORT=8009
HOST=127.0.0.1

# Service account credential downloaded from the GCP console. chmod 600.
GOOGLE_SA_KEY_FILE=/home/hermes/services/calendar-gate/sa-key.json

# Calendar registry (id + share level) and principal registry (key hashes).
CALENDARS_FILE=/home/hermes/services/calendar-gate/calendars.json
PRINCIPALS_FILE=/home/hermes/services/calendar-gate/principals.json

# Timezone used when a request does not carry one. Brazil has had no DST since
# 2019, but nothing here derives from that: the offset is always written out.
DEFAULT_TIMEZONE=America/Sao_Paulo

# Write caps. A fan-out counts as N writes, not one.
MAX_WRITES_PER_MIN=10
MAX_WRITES_PER_DAY=50

# Date guards (hours into the past, days into the future).
MAX_PAST_HOURS=24
MAX_FUTURE_DAYS=730

# Audit trail
LOG_RETENTION_DAYS=30

# Alerts for credential failure and exhausted write caps. No key, no alerts.
GOSSIP_URL=http://127.0.0.1:8080/api/gossip-gate/send
GOSSIP_API_KEY=
